{
  "name": "icash",
  "version": "0.1.0",
  "private": true,
  "description": "Offline household budgeting for South Africa",
  "author": "iCash contributors",
  "productName": "iCash",
  "main": "dist/desktop/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "ng build && node scripts/build-desktop.mjs",
    "dev": "npm run build && node scripts/run-electron.mjs",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit && ngc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "make": "npm run build && electron-forge make",
    "postinstall": "node scripts/patch-build-dependencies.mjs"
  },
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "better-sqlite3-multiple-ciphers": "13.2.0",
    "chart.js": "4.6.1",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "invensys-ng": "23.3.3",
    "primeicons": "7.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "electron": "42.11.18",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "overrides": {
    "glob@>=9.0.0 <=14.0.1": "14.0.6",
    "minimatch@>=7.0.0 <11.0.1": "11.0.9",
    "picomatch": "4.0.7"
  }
}
