{
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  },
  "projects": {
    "icash": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/renderer",
            "browser": "src/app/renderer/main.ts",
            "index": "src/app/renderer/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "primeicons/primeicons.css",
              "src/app/renderer/styles.scss"
            ],
            "baseHref": "./",
            "outputHashing": "all",
            "extractLicenses": true,
            "assets": [
              {
                "glob": "**/*",
                "input": "src/app/renderer/assets",
                "output": "assets"
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules"
              ]
            },
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": false
            }
          }
        }
      }
    }
  }
}
